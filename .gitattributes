# normalize line endings
* text=auto eol=lf

# สคริปต์ที่ grader ให้มา — ต้องรันได้ทั้งสองเครื่อง
*.sh  text eol=lf
*.bat text eol=crlf

# binary — อย่าแตะ
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
*.exe  binary
*.out  binary
*.o    binary
*.bmp  binary
*.docx binary
*.pptx binary
