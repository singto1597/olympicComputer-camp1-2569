# คัดลอกไฟล์นี้เป็น tools/secrets.fish แล้วเติมค่าจริง
#   cp tools/secrets.fish.example tools/secrets.fish
#
# tools/secrets.fish ถูก gitignore ไว้ — จะไม่มีทางขึ้น git

# URL ฐานของ grader (ยังไม่ต้องมี /tasks/... ปิดท้าย)
# ตัวอย่างของค่าย 2 ปี 2568:
#   set -gx GRADER_BASE_URL "https://www.cs.science.cmu.ac.th/gradero/02_comp_o_camp2"
set -gx GRADER_BASE_URL ""

# Cookie จากเบราว์เซอร์หลังล็อกอินเข้า grader
# เปิด DevTools → Network → กดโหลดอะไรก็ได้ → ก็อปค่า header "Cookie" มาวางทั้งเส้น
set -gx USER_COOKIE ""
