# คัดลอกไฟล์นี้เป็น tools/secrets.fish แล้วเติมค่าจริง
#   cp tools/secrets.fish.example tools/secrets.fish
#
# tools/secrets.fish กับ tools/.cookies.txt ถูก gitignore ไว้ — ไม่มีทางขึ้น git

# ---------- URL ฐานของ grader (ไม่ต้องมี / ปิดท้าย) ----------
set -gx GRADER_BASE_URL "https://www.cs.science.cmu.ac.th/compo/09_pre_camp1"

# ---------- วิธีล็อกอิน ----------
#   cms    = ฟอร์ม login ของ CMS/Zebra (GET หน้าแรก → _xsrf → POST /login)
#            ใช้กับ cs.science.cmu.ac.th/compo/... ต้องมี GRADER_USER + GRADER_PASS
#   cookie = ยิง header Cookie ตรง ๆ ต้องมี GRADER_COOKIE
#            ใช้กับ gradero ของค่าย 2 (ก็อปจากเบราว์เซอร์ → DevTools → Network → Cookie)
#   none   = ไม่ต้องยืนยันตัวตน
set -gx GRADER_AUTH cms

# ---------- ใช้เมื่อ GRADER_AUTH = cms ----------
set -gx GRADER_USER ""
set -gx GRADER_PASS ""

# ---------- ใช้เมื่อ GRADER_AUTH = cookie ----------
set -gx GRADER_COOKIE ""

# ---------- path ของ statement ({id} จะถูกแทนด้วยรหัสโจทย์) ----------
#   Zebra/CMS : /tasks/{id}/statements/th   (หรือ /en)
#   gradero   : /tasks/{id}/statements/pdf
set -gx GRADER_STATEMENT_PATH "/tasks/{id}/statements/th"
